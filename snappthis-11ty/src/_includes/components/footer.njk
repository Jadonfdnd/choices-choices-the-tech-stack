{#
	Footer-navigatie als macro.
	In SvelteKit kwam de huidige URL uit $app/state. In 11ty geef je hem mee als argument: page.url.
#}
{% macro footer(currentUrl) %}
<footer class="footer">
	<nav class="footer-nav" aria-label="Main navigation">
		<ul class="footer-nav-list">
			<li class="footer-nav-item">
				<a href="/" class="footer-nav-link{% if currentUrl == '/' %} active{% endif %}" aria-label="Home"{% if currentUrl == '/' %} aria-current="page"{% endif %}>
					<svg class="footer-nav-icon" width="47" height="48" viewBox="0 0 47 48" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
						<path fill-rule="evenodd" clip-rule="evenodd" d="PLAK_HIER_HET_HOME_PAD" />
					</svg>
				</a>
			</li>
			<li class="footer-nav-item">
				<a href="/groups/" class="footer-nav-link{% if currentUrl == '/groups/' %} active{% endif %}" aria-label="Groups"{% if currentUrl == '/groups/' %} aria-current="page"{% endif %}>
					<svg class="footer-nav-icon" width="40" height="36" viewBox="0 0 40 36" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
						<path fill-rule="evenodd" clip-rule="evenodd" d="PLAK_HIER_HET_GROUPS_PAD" />
					</svg>
				</a>
			</li>
			<li class="footer-nav-item">
				<a href="/user/" class="footer-nav-link{% if currentUrl == '/user/' %} active{% endif %}" aria-label="User"{% if currentUrl == '/user/' %} aria-current="page"{% endif %}>
					<svg class="footer-nav-icon" width="35" height="35" viewBox="0 0 35 35" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
						<path fill-rule="evenodd" clip-rule="evenodd" d="M17.5 17.5C22.3325 17.5 26.25 13.5825 26.25 8.75C26.25 3.91751 22.3325 0 17.5 0C12.6675 0 8.75 3.91751 8.75 8.75C8.75 13.5825 12.6675 17.5 17.5 17.5ZM35 35C34.902 26.7841 27.1036 20.1467 17.5 20.1467C7.89635 20.1467 0.098 26.7837 0 35H35Z" />
					</svg>
				</a>
			</li>
		</ul>
	</nav>
</footer>
{% endmacro %}
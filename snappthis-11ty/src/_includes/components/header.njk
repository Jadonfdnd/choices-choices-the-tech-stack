{#
	Header als Nunjucks-macro. Een macro werkt ongeveer zoals een Svelte-component:
	je roept hem aan met "props" en hij geeft HTML terug.
#}
{% macro header(title = '', showBackButton = false, showAddButton = false, backUrl = '/') %}
<header class="top-nav">
	{% if showBackButton %}
		<a href="{{ backUrl }}" class="go-back-link" aria-label="Go back">
			<svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
				<path fill-rule="evenodd" clip-rule="evenodd" d="M7.6 14L18.8 2.8L16 0L0 16L16 32L18.8 29.2L7.6 18H32V14H7.6Z" />
			</svg>
		</a>
	{% endif %}

	<h1 class="title">{{ title }}</h1>

	{% if showAddButton %}
		<button type="button" class="add-button" aria-label="Add">
			<svg class="right-center-icon" viewBox="0 0 36 36" aria-hidden="true">
				<path fill-rule="evenodd" clip-rule="evenodd" d="M36 20.5714H20.5714V36H15.4286V20.5714H0V15.4286H15.4286V0H20.5714V15.4286H36V20.5714Z" />
			</svg>
		</button>
	{% endif %}
</header>
{% endmacro %}